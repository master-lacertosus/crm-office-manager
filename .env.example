# Copia in .env.local e compila (mai committare .env.local: è già in .gitignore).
# I valori stanno nel dashboard Supabase: Project Settings › API.
#
# Finché queste variabili sono vuote l'app continua a girare sui dati mock:
# il proxy si disattiva da solo e non rompe niente.

# URL del progetto, es. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chiave «anon public». Finisce nel bundle del browser, ed è corretto così:
# da sola non autorizza nulla, è la RLS a decidere cosa si può leggere.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO LATO SERVER — mai esporre al client, mai prefissare con NEXT_PUBLIC_.
# Bypassa la RLS: chi la possiede ha pieni poteri sul database.
# Usata esclusivamente dalla Server Action di invito (docs/SECURITY_MODEL.md).
SUPABASE_SERVICE_ROLE_KEY=

# --- Email dei lavori assegnati (M15) ------------------------------------
# Finché queste tre sono vuote la rotta /api/avvisi-email risponde e non manda
# niente: nessun errore, nessuna mail. L'app resta identica.

# Chiave API di Resend (resend.com › API Keys). Permesso: solo invio.
RESEND_API_KEY=

# Il mittente. Deve stare su un dominio VERIFICATO in Resend, altrimenti le
# mail vengono rifiutate. Es: Lacertosus Office <avvisi@lacertosus.com>
MITTENTE_EMAIL=

# Segreto condiviso con il lavoro pianificato del database: la rotta rifiuta
# chi non lo presenta. Lo stesso valore va nella tabella impostazioni_invio
# su Supabase (vedi ULTIMO PASSO in supabase/migrations/…m15….sql).
# Generane uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEGRETO_INVIO_EMAIL=

# Indirizzo pubblico dell'app, per i link dentro le email. Se manca si deduce
# dalla richiesta, che però in questo caso arriva dal database e non dal
# browser: meglio dirlo. Es: https://lct-ufficio.vercel.app
BASE_URL_APP=
