# Copia in .env.local e compila (mai committare .env.local).
# Valori locali: `supabase start` li stampa a terminale.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO LATO SERVER — mai esporre al client, mai prefissare con NEXT_PUBLIC_.
# Usata esclusivamente dalla Server Action di invito (docs/SECURITY_MODEL.md).
SUPABASE_SERVICE_ROLE_KEY=
