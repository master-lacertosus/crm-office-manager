# Copia in .env.local e compila (mai committare .env.local: è già in .gitignore).
# I valori stanno nel dashboard Supabase: Project Settings › API.
#
# Finché queste variabili sono vuote l'app continua a girare sui dati mock:
# il proxy si disattiva da solo e non rompe niente.

# URL del progetto, es. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chiave «anon public». Finisce nel bundle del browser, ed è corretto così:
# da sola non autorizza nulla, è la RLS a decidere cosa si può leggere.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO LATO SERVER — mai esporre al client, mai prefissare con NEXT_PUBLIC_.
# Bypassa la RLS: chi la possiede ha pieni poteri sul database.
# Usata esclusivamente dalla Server Action di invito (docs/SECURITY_MODEL.md).
SUPABASE_SERVICE_ROLE_KEY=
